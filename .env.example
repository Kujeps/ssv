# Токен от @BotFather
BOT_TOKEN=

# Telegram ID админов (через запятую). Свой ID узнать: @userinfobot.
# Админ видит все заявки, управляет модераторами, смотрит статистику, выгружает Excel,
# создаёт рекламные ссылки и делает рассылки. Модераторов админ добавляет прямо в боте.
ADMIN_USER_IDS=

# --- необязательные настройки ---

# Часовой пояс для времени в карточках и Excel: смещение от UTC, по умолчанию 3 (Москва).
TZ_OFFSET_HOURS=3

# Сколько минут у модератора на обработку взятой заявки, потом она вернётся в очередь (по умолчанию 60).
HOLD_MINUTES=60

# Через сколько часов просроченный перезвон возвращается в общую очередь (по умолчанию 24).
CALLBACK_RETURN_HOURS=24

