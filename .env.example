# Токен от @BotFather
BOT_TOKEN=

# Чат(ы), куда бот присылает готовые заявки — группа менеджеров (через запятую).
# ID супергруппы начинается с -100. Бот должен быть в группе администратором.
ADMIN_CHAT_IDS=

# Telegram ID админов: команды /stats, /export, /broadcast и уведомления о /start (через запятую).
# Свой ID узнать: @userinfobot
ADMIN_USER_IDS=

# (необязательно) Telegram ID менеджеров, которым разрешено менять статусы заявок и писать заметки.
# Пусто — может любой участник группы заявок. Админы из ADMIN_USER_IDS могут всегда.
MANAGER_IDS=

# (необязательно) Часовой пояс для времени в карточках и Excel — смещение от UTC, по умолчанию 3 (Москва).
TZ_OFFSET_HOURS=3

# (необязательно) Через сколько минут напоминать о заявке без обработки. 0 — выключить.
REMIND_AFTER_MIN=30
